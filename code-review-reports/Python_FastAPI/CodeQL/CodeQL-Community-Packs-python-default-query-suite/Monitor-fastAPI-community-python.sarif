{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","version":"2.1.0","runs":[{"tool":{"driver":{"name":"CodeQL","organization":"GitHub","semanticVersion":"2.25.4","notifications":[{"id":"py/baseline/expected-extracted-files","name":"py/baseline/expected-extracted-files","shortDescription":{"text":"Expected extracted files"},"fullDescription":{"text":"Files appearing in the source archive that are expected to be extracted."},"defaultConfiguration":{"enabled":true},"properties":{"tags":["expected-extracted-files","telemetry"]}},{"id":"cli/file-coverage-baseline","name":"cli/file-coverage-baseline","shortDescription":{"text":"File coverage baseline telemetry"},"fullDescription":{"text":"File coverage baseline telemetry"},"defaultConfiguration":{"enabled":true}},{"id":"cli/platform","name":"cli/platform","shortDescription":{"text":"Platform"},"fullDescription":{"text":"Platform"},"defaultConfiguration":{"enabled":true}}],"rules":[{"id":"githubsecuritylab/xxe-local-string-taint","name":"githubsecuritylab/xxe-local-string-taint","shortDescription":{"text":"Deserializing XML from user-controlled data"},"fullDescription":{"text":"Parsing user-controlled XML data (e.g. allowing expansion of external entity references) may lead to disclosure of confidential data or denial of service."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","local","external/cwe/cwe-611","external/cwe/cwe-776","external/cwe/cwe-827","external/cwe/cwe-502"],"description":"Parsing user-controlled XML data (e.g. allowing expansion of external entity\n references) may lead to disclosure of confidential data or denial of service.","id":"githubsecuritylab/xxe-local-string-taint","kind":"path-problem","name":"Deserializing XML from user-controlled data","precision":"high","problem.severity":"error","security-severity":"6.0"}},{"id":"githubsecuritylab/unsafe-deserialization","name":"githubsecuritylab/unsafe-deserialization","shortDescription":{"text":"Deserializing untrusted input"},"fullDescription":{"text":"Deserializing user-controlled data may allow attackers to execute arbitrary code."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["external/cwe/cwe-502","security","serialization","local"],"description":"Deserializing user-controlled data may allow attackers to execute arbitrary code.","id":"githubsecuritylab/unsafe-deserialization","kind":"path-problem","name":"Deserializing untrusted input","precision":"low","problem.severity":"error","security-severity":"8.0","sub-severity":"high"}},{"id":"githubsecuritylab/xxe-local-file-taint","name":"githubsecuritylab/xxe-local-file-taint","shortDescription":{"text":"Deserializing XML from user-controlled filename"},"fullDescription":{"text":"Parsing XML data from a user-controlled filename (e.g. allowing expansion of external entity references) may lead to disclosure of confidential data or denial of service."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","local","external/cwe/cwe-611","external/cwe/cwe-776","external/cwe/cwe-827","external/cwe/cwe-502"],"description":"Parsing XML data from a user-controlled filename (e.g. allowing expansion of external entity\n references) may lead to disclosure of confidential data or denial of service.","id":"githubsecuritylab/xxe-local-file-taint","kind":"path-problem","name":"Deserializing XML from user-controlled filename","precision":"high","problem.severity":"error","security-severity":"6.0"}},{"id":"githubsecuritylab/code-injection","name":"githubsecuritylab/code-injection","shortDescription":{"text":"Code injection"},"fullDescription":{"text":"Interpreting unsanitized user input as code allows a malicious user to perform arbitrary code execution."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","external/owasp/owasp-a1","external/cwe/cwe-094","external/cwe/cwe-095","external/cwe/cwe-116","local"],"description":"Interpreting unsanitized user input as code allows a malicious user to perform arbitrary\n              code execution.","id":"githubsecuritylab/code-injection","kind":"path-problem","name":"Code injection","precision":"low","problem.severity":"error","security-severity":"10.0","sub-severity":"critical"}},{"id":"githubsecuritylab/command-line-injection","name":"githubsecuritylab/command-line-injection","shortDescription":{"text":"Uncontrolled command line"},"fullDescription":{"text":"Using externally controlled strings in a command line may allow a malicious user to change the meaning of the command."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","external/cwe/cwe-078","external/cwe/cwe-088","external/owasp/owasp-a1","local"],"description":"Using externally controlled strings in a command line may allow a malicious\n              user to change the meaning of the command.","id":"githubsecuritylab/command-line-injection","kind":"path-problem","name":"Uncontrolled command line","precision":"low","problem.severity":"error","security-severity":"10.0","sub-severity":"critical"}},{"id":"githubsecuritylab/sql-injection","name":"githubsecuritylab/sql-injection","shortDescription":{"text":"SQL query built from user-controlled sources"},"fullDescription":{"text":"Building a SQL query from user-controlled sources is vulnerable to insertion of malicious SQL code by the user."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","external/cwe/cwe-089","external/owasp/owasp-a1","local"],"description":"Building a SQL query from user-controlled sources is vulnerable to insertion of\n              malicious SQL code by the user.","id":"githubsecuritylab/sql-injection","kind":"path-problem","name":"SQL query built from user-controlled sources","precision":"low","problem.severity":"error","security-severity":"10.0","sub-severity":"critical"}},{"id":"githubsecuritylab/default-password-db","name":"githubsecuritylab/default-password-db","shortDescription":{"text":"Python default password"},"fullDescription":{"text":"Default password set in security sensitive database column"},"defaultConfiguration":{"enabled":true,"level":"error"},"help":{"text":"# Python default password\nDefault passwords are often used to simplify setup of single-user systems, or even multi-user systems. For single-user systems they expose users to attackers who are well aware of the default password. They may use it in mass attacks on websites or may target the product more precisely and then look up the default. In multi-user systems with default passwords, any user that has an account created knows the starting password for every other user. Even if a password change method is provided, there is a time window during which users may authenticate to others' accounts.\n\n\n## Recommendation\nRemove the default for the password.\n\n\n## Example\nIn this insecure snippet of Python, a password column has a default password set:\n\n```python\n\nfrom flask import Flask\nfrom flask_login import UserMixin\nfrom flask_sqlalchemy import SQLAlchemy\n\napp = Flask(__name__)\ndb = SQLAlchemy(app)\n\nclass User(db.Model, UserMixin):\n    __tablename__ = 'users'\n    id = db.Column(db.Integer, primary_key=True)\n    username = db.Column(db.String(80), unique=True, nullable=False)\n    password = db.Column(db.String(80), default=\"password\", nullable=False)\n\n\t...\n\n```\nIn this example, no default is provided, so the user must set their own password:\n\n```python\n\nfrom flask import Flask\nfrom flask_login import UserMixin\nfrom flask_sqlalchemy import SQLAlchemy\n\napp = Flask(__name__)\ndb = SQLAlchemy(app)\n\nclass SecureUser(db.Model, UserMixin):\n    __tablename__ = 'secure_users'\n    id = db.Column(db.Integer, primary_key=True)\n    username = db.Column(db.String(80), unique=True, nullable=False)\n    password = db.Column(db.String(80), nullable=False)\n\n\t...\n\n```\n","markdown":"# Python default password\nDefault passwords are often used to simplify setup of single-user systems, or even multi-user systems. For single-user systems they expose users to attackers who are well aware of the default password. They may use it in mass attacks on websites or may target the product more precisely and then look up the default. In multi-user systems with default passwords, any user that has an account created knows the starting password for every other user. Even if a password change method is provided, there is a time window during which users may authenticate to others' accounts.\n\n\n## Recommendation\nRemove the default for the password.\n\n\n## Example\nIn this insecure snippet of Python, a password column has a default password set:\n\n```python\n\nfrom flask import Flask\nfrom flask_login import UserMixin\nfrom flask_sqlalchemy import SQLAlchemy\n\napp = Flask(__name__)\ndb = SQLAlchemy(app)\n\nclass User(db.Model, UserMixin):\n    __tablename__ = 'users'\n    id = db.Column(db.Integer, primary_key=True)\n    username = db.Column(db.String(80), unique=True, nullable=False)\n    password = db.Column(db.String(80), default=\"password\", nullable=False)\n\n\t...\n\n```\nIn this example, no default is provided, so the user must set their own password:\n\n```python\n\nfrom flask import Flask\nfrom flask_login import UserMixin\nfrom flask_sqlalchemy import SQLAlchemy\n\napp = Flask(__name__)\ndb = SQLAlchemy(app)\n\nclass SecureUser(db.Model, UserMixin):\n    __tablename__ = 'secure_users'\n    id = db.Column(db.Integer, primary_key=True)\n    username = db.Column(db.String(80), unique=True, nullable=False)\n    password = db.Column(db.String(80), nullable=False)\n\n\t...\n\n```\n"},"properties":{"tags":["default-password","python","external/cwe/cwe-1393","external/cwe/cwe-1392","external/cwe/cwe-287","external/cwe/cwe-284"],"description":"Default password set in security sensitive database column","id":"githubsecuritylab/default-password-db","kind":"problem","name":"Python default password","precision":"high","problem.severity":"error"}},{"id":"githubsecuritylab/hardcoded-credentials","name":"githubsecuritylab/hardcoded-credentials","shortDescription":{"text":"Hard-coded credentials"},"fullDescription":{"text":"Credentials are hard coded in the source code of the application."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","external/cwe/cwe-259","external/cwe/cwe-321","external/cwe/cwe-798"],"description":"Credentials are hard coded in the source code of the application.","id":"githubsecuritylab/hardcoded-credentials","kind":"path-problem","name":"Hard-coded credentials","precision":"medium","problem.severity":"error","security-severity":"5.9","sub-severity":"medium"}},{"id":"githubsecuritylab/weak-cryptographic-hmac-algorithm","name":"githubsecuritylab/weak-cryptographic-hmac-algorithm","shortDescription":{"text":"Use of Cryptographically Weak HMAC Algorithm"},"fullDescription":{"text":"Use of Cryptographically Weak HMAC Algorithm"},"defaultConfiguration":{"enabled":true,"level":"warning"},"properties":{"tags":["security","external/cwe/cwe-327","external/cwe/cwe-330"],"description":"Use of Cryptographically Weak HMAC Algorithm","id":"githubsecuritylab/weak-cryptographic-hmac-algorithm","kind":"problem","name":"Use of Cryptographically Weak HMAC Algorithm","precision":"medium","problem.severity":"warning","security-severity":"5.0","sub-severity":"medium"}},{"id":"githubsecuritylab/weak-cryptographic-algorithm","name":"githubsecuritylab/weak-cryptographic-algorithm","shortDescription":{"text":"Use of a broken or weak cryptographic algorithm"},"fullDescription":{"text":"Using broken or weak cryptographic algorithms can compromise security."},"defaultConfiguration":{"enabled":true,"level":"warning"},"properties":{"tags":["security","experimental","external/cwe/cwe-327"],"description":"Using broken or weak cryptographic algorithms can compromise security.","id":"githubsecuritylab/weak-cryptographic-algorithm","kind":"problem","name":"Use of a broken or weak cryptographic algorithm","precision":"high","problem.severity":"warning","security-severity":"5.0","sub-severity":"medium"}},{"id":"githubsecuritylab/weak-cryptographic-prng","name":"githubsecuritylab/weak-cryptographic-prng","shortDescription":{"text":"Use of Cryptographically Weak Pseudo-Random Number Generator"},"fullDescription":{"text":"Use of Cryptographically Weak Pseudo-Random Number Generator (PRNG)."},"defaultConfiguration":{"enabled":true,"level":"warning"},"properties":{"tags":["security","external/cwe/cwe-338"],"description":"Use of Cryptographically Weak Pseudo-Random Number Generator (PRNG).","id":"githubsecuritylab/weak-cryptographic-prng","kind":"problem","name":"Use of Cryptographically Weak Pseudo-Random Number Generator","precision":"low","problem.severity":"warning","security-severity":"6.0","sub-severity":"medium"}},{"id":"githubsecuritylab/insecurely-stored-pw","name":"githubsecuritylab/insecurely-stored-pw","shortDescription":{"text":"Python insecurely stored password"},"fullDescription":{"text":"Password stored insecurely directly in database without hashing with a secure password hash"},"defaultConfiguration":{"enabled":true,"level":"error"},"help":{"text":"# Python insecurely stored password\nStoring passwords in plain text or in a reversible format is insecure. They can be recovered by either reading them straight out (in the case of plain text), or by reversing the storage method. Trivial encodings such as Base64 or hex encoding are not sufficient. Even encryption is not appropriate for storing passwords, since it can be reversed if the encryption key is stolen along with the passwords.\n\n\n## Recommendation\nUse strong, non-reversible cryptographic hashing to protect stored passwords. With Python, it is common to use Werkzeug's `generate_password_hash` function, but Flask-BCrypt and Flask-Argon2 are more modern and give you control over the number of \"rounds\" of hashing (repeated hashing to make reversing the hashing harder). You should ensure that you not only use such a function, but also use it securely. Make sure that the hashing function used is sufficiently strong (e.g. SHA-512) and that you use a per-password salt (which Werkzeug, BCrypt and Argon2 all do).\n\n\n## Example\nIn this insecure snippet of Python, a password is stored with no hashing:\n\n```python\n\nfrom flask import Flask, request\nfrom flask_login import UserMixin\nfrom flask_sqlalchemy import SQLAlchemy\n\napp = Flask(__name__)\ndb = SQLAlchemy(app)\n\nclass User(db.Model, UserMixin):\n    __tablename__ = 'insecure_users'\n    id = db.Column(db.Integer, primary_key=True)\n    username = db.Column(db.String(80), unique=True, nullable=False)\n    password = db.Column(db.String(80))\n\n```\nIn this example, the password is hashed before it is stored:\n\n```python\n\nfrom flask import Flask, request\nfrom flask_login import UserMixin\nfrom flask_sqlalchemy import SQLAlchemy\nfrom werkzeug.security import generate_password_hash\n\napp = Flask(__name__)\ndb = SQLAlchemy(app)\n\nclass SecureUser(db.Model, UserMixin):\n    __tablename__ = 'secure_users'\n    id = db.Column(db.Integer, primary_key=True)\n    username = db.Column(db.String(80), unique=True, nullable=False)\n    password = db.Column(db.String(80))\n\n    def __init__(self, username, password):\n        self.username = username\n        self.password = generate_password_hash(password, method=\"pbkdf2:sha512\")\n\n```\n\n## References\n* [werkzeug.generate_password_hash](https://tedboy.github.io/flask/generated/werkzeug.generate_password_hash.html)\n* Common Weakness Enumeration: [CWE-256](https://cwe.mitre.org/data/definitions/256.html).\n* Common Weakness Enumeration: [CWE-257](https://cwe.mitre.org/data/definitions/257.html).\n* Common Weakness Enumeration: [CWE-522](https://cwe.mitre.org/data/definitions/522.html).\n","markdown":"# Python insecurely stored password\nStoring passwords in plain text or in a reversible format is insecure. They can be recovered by either reading them straight out (in the case of plain text), or by reversing the storage method. Trivial encodings such as Base64 or hex encoding are not sufficient. Even encryption is not appropriate for storing passwords, since it can be reversed if the encryption key is stolen along with the passwords.\n\n\n## Recommendation\nUse strong, non-reversible cryptographic hashing to protect stored passwords. With Python, it is common to use Werkzeug's `generate_password_hash` function, but Flask-BCrypt and Flask-Argon2 are more modern and give you control over the number of \"rounds\" of hashing (repeated hashing to make reversing the hashing harder). You should ensure that you not only use such a function, but also use it securely. Make sure that the hashing function used is sufficiently strong (e.g. SHA-512) and that you use a per-password salt (which Werkzeug, BCrypt and Argon2 all do).\n\n\n## Example\nIn this insecure snippet of Python, a password is stored with no hashing:\n\n```python\n\nfrom flask import Flask, request\nfrom flask_login import UserMixin\nfrom flask_sqlalchemy import SQLAlchemy\n\napp = Flask(__name__)\ndb = SQLAlchemy(app)\n\nclass User(db.Model, UserMixin):\n    __tablename__ = 'insecure_users'\n    id = db.Column(db.Integer, primary_key=True)\n    username = db.Column(db.String(80), unique=True, nullable=False)\n    password = db.Column(db.String(80))\n\n```\nIn this example, the password is hashed before it is stored:\n\n```python\n\nfrom flask import Flask, request\nfrom flask_login import UserMixin\nfrom flask_sqlalchemy import SQLAlchemy\nfrom werkzeug.security import generate_password_hash\n\napp = Flask(__name__)\ndb = SQLAlchemy(app)\n\nclass SecureUser(db.Model, UserMixin):\n    __tablename__ = 'secure_users'\n    id = db.Column(db.Integer, primary_key=True)\n    username = db.Column(db.String(80), unique=True, nullable=False)\n    password = db.Column(db.String(80))\n\n    def __init__(self, username, password):\n        self.username = username\n        self.password = generate_password_hash(password, method=\"pbkdf2:sha512\")\n\n```\n\n## References\n* [werkzeug.generate_password_hash](https://tedboy.github.io/flask/generated/werkzeug.generate_password_hash.html)\n* Common Weakness Enumeration: [CWE-256](https://cwe.mitre.org/data/definitions/256.html).\n* Common Weakness Enumeration: [CWE-257](https://cwe.mitre.org/data/definitions/257.html).\n* Common Weakness Enumeration: [CWE-522](https://cwe.mitre.org/data/definitions/522.html).\n"},"properties":{"tags":["password","python","external/cwe/cwe-256","external/cwe/cwe-257","external/cwe/cwe-522"],"description":"Password stored insecurely directly in database without hashing with a secure password hash","id":"githubsecuritylab/insecurely-stored-pw","kind":"problem","name":"Python insecurely stored password","precision":"high","problem.severity":"error"}},{"id":"githubsecuritylab/insufficient-logging","name":"githubsecuritylab/insufficient-logging","shortDescription":{"text":"Insufficient Logging"},"fullDescription":{"text":"Insufficient Logging"},"defaultConfiguration":{"enabled":true,"level":"warning"},"properties":{"tags":["security","external/cwe/cwe-778"],"description":"Insufficient Logging","id":"githubsecuritylab/insufficient-logging","kind":"problem","name":"Insufficient Logging","precision":"low","problem.severity":"warning","security-severity":"1.0","sub-severity":"low"}},{"id":"githubsecuritylab/format-string","name":"githubsecuritylab/format-string","shortDescription":{"text":"Python user-controlled format string"},"fullDescription":{"text":"User-controlled format string can result in Denial-of-Service or information leaks"},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["format-string","python","security","external/cwe/cwe-134","external/cwe/cwe-133"],"description":"User-controlled format string can result in Denial-of-Service or information leaks","id":"githubsecuritylab/format-string","kind":"path-problem","name":"Python user-controlled format string","precision":"low","problem.severity":"error"}},{"id":"githubsecuritylab/mass-assignment-problem-local","name":"githubsecuritylab/mass-assignment-problem-local","shortDescription":{"text":"Mass assignment"},"fullDescription":{"text":"Mass assignment is a vulnerability that allows an attacker to modify multiple attributes of a model at once."},"defaultConfiguration":{"enabled":true,"level":"warning"},"properties":{"tags":["security","external/cwe/cwe-2915","local","testing"],"description":"Mass assignment is a vulnerability that allows an attacker to\n             modify multiple attributes of a model at once.","id":"githubsecuritylab/mass-assignment-problem-local","kind":"problem","name":"Mass assignment","precision":"high","problem.severity":"warning","security-severity":"2.0","sub-severity":"high"}},{"id":"githubsecuritylab/mass-assignment-problem","name":"githubsecuritylab/mass-assignment-problem","shortDescription":{"text":"Mass assignment"},"fullDescription":{"text":"Mass assignment is a vulnerability that allows an attacker to modify multiple attributes of a model at once."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","external/cwe/cwe-2915","testing","local"],"description":"Mass assignment is a vulnerability that allows an attacker to\n             modify multiple attributes of a model at once.","id":"githubsecuritylab/mass-assignment-problem","kind":"problem","name":"Mass assignment","precision":"high","problem.severity":"error","security-severity":"8.0","sub-severity":"high"}},{"id":"githubsecuritylab/mass-assignment-local","name":"githubsecuritylab/mass-assignment-local","shortDescription":{"text":"Mass assignment"},"fullDescription":{"text":"Mass assignment is a vulnerability that allows an attacker to modify multiple attributes of a model at once."},"defaultConfiguration":{"enabled":true,"level":"warning"},"properties":{"tags":["security","local","external/cwe/cwe-2915"],"description":"Mass assignment is a vulnerability that allows an attacker to\n             modify multiple attributes of a model at once.","id":"githubsecuritylab/mass-assignment-local","kind":"path-problem","name":"Mass assignment","precision":"high","problem.severity":"warning","security-severity":"2.0","sub-severity":"high"}},{"id":"githubsecuritylab/mass-assignment","name":"githubsecuritylab/mass-assignment","shortDescription":{"text":"Mass assignment"},"fullDescription":{"text":"Mass assignment is a vulnerability that allows an attacker to modify multiple attributes of a model at once."},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["security","external/cwe/cwe-2915"],"description":"Mass assignment is a vulnerability that allows an attacker to\n             modify multiple attributes of a model at once.","id":"githubsecuritylab/mass-assignment","kind":"path-problem","name":"Mass assignment","precision":"high","problem.severity":"error","security-severity":"8.0","sub-severity":"high"}},{"id":"githubsecuritylab/forward-partial-dataflow","name":"githubsecuritylab/forward-partial-dataflow","shortDescription":{"text":"Forward Partial Dataflow"},"fullDescription":{"text":"Forward Partial Dataflow"},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["template"],"description":"Forward Partial Dataflow","id":"githubsecuritylab/forward-partial-dataflow","kind":"path-problem","name":"Forward Partial Dataflow","precision":"low","problem.severity":"error"}},{"id":"githubsecuritylab/backwards-partial-dataflow","name":"githubsecuritylab/backwards-partial-dataflow","shortDescription":{"text":"Backwards Partial Dataflow"},"fullDescription":{"text":"Backwards Partial Dataflow"},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["template"],"description":"Backwards Partial Dataflow","id":"githubsecuritylab/backwards-partial-dataflow","kind":"path-problem","name":"Backwards Partial Dataflow","precision":"low","problem.severity":"error"}},{"id":"githubsecuritylab/dataflow-query","name":"githubsecuritylab/dataflow-query","shortDescription":{"text":"DataFlow configuration"},"fullDescription":{"text":"DataFlow TaintTracking configuration"},"defaultConfiguration":{"enabled":true,"level":"error"},"properties":{"tags":["template"],"description":"DataFlow TaintTracking configuration","id":"githubsecuritylab/dataflow-query","kind":"path-problem","name":"DataFlow configuration","precision":"low","problem.severity":"error"}}]},"extensions":[{"name":"githubsecuritylab/codeql-python-queries","semanticVersion":"0.2.1+3a9acb5752dea58693036951ad74049364381c1b","locations":[{"uri":"file:///home/ubuntu/.codeql/packages/githubsecuritylab/codeql-python-queries/0.2.1/","description":{"text":"The QL pack root directory."},"properties":{"tags":["CodeQL/LocalPackRoot"]}},{"uri":"file:///home/ubuntu/.codeql/packages/githubsecuritylab/codeql-python-queries/0.2.1/qlpack.yml","description":{"text":"The QL pack definition file."},"properties":{"tags":["CodeQL/LocalPackDefinitionFile"]}}]},{"name":"codeql/python-all","semanticVersion":"3.1.0+d42788844f7ec0a6b9832140313cc2318e513987","locations":[{"uri":"file:///home/ubuntu/.codeql/packages/githubsecuritylab/codeql-python-queries/0.2.1/.codeql/libraries/codeql/python-all/3.1.0/","description":{"text":"The QL pack root directory."},"properties":{"tags":["CodeQL/LocalPackRoot"]}},{"uri":"file:///home/ubuntu/.codeql/packages/githubsecuritylab/codeql-python-queries/0.2.1/.codeql/libraries/codeql/python-all/3.1.0/qlpack.yml","description":{"text":"The QL pack definition file."},"properties":{"tags":["CodeQL/LocalPackDefinitionFile"]}}]},{"name":"codeql/threat-models","semanticVersion":"1.0.14+d42788844f7ec0a6b9832140313cc2318e513987","locations":[{"uri":"file:///home/ubuntu/.codeql/packages/githubsecuritylab/codeql-python-queries/0.2.1/.codeql/libraries/codeql/threat