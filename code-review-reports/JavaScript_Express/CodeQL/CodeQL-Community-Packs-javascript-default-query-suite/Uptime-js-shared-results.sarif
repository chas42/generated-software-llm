"index":0},"properties":{"formattedMessage":{"text":""}}},{"locations":[{"physicalLocation":{"artifactLocation":{"uri":"project/src/App.tsx","uriBaseId":"%SRCROOT%","index":7}}}],"message":{"text":""},"level":"none","descriptor":{"id":"js/baseline/expected-extracted-files","index":0},"properties":{"formattedMessage":{"text":""}}},{"message":{"text":""},"level":"none","timeUtc":"2026-07-17T16:29:02.530888643Z","descriptor":{"id":"cli/file-coverage-baseline","index":1},"properties":{"attributes":{"durationMilliseconds":65},"visibility":{"statusPage":false,"telemetry":true}}},{"message":{"text":""},"level":"none","timeUtc":"2026-07-17T16:29:02.533042930Z","descriptor":{"id":"cli/platform","index":2},"properties":{"attributes":{"arch":"amd64","name":"Linux","version":"6.8.0-124-generic"},"visibility":{"statusPage":false,"telemetry":true}}}],"executionSuccessful":true}],"artifacts":[{"location":{"uri":"project/eslint.config.js","uriBaseId":"%SRCROOT%","index":0}},{"location":{"uri":"project/tailwind.config.js","uriBaseId":"%SRCROOT%","index":1}},{"location":{"uri":"project/src/server.js","uriBaseId":"%SRCROOT%","index":2}},{"location":{"uri":"project/postcss.config.js","uriBaseId":"%SRCROOT%","index":3}},{"location":{"uri":"project/src/main.tsx","uriBaseId":"%SRCROOT%","index":4}},{"location":{"uri":"project/src/vite-env.d.ts","uriBaseId":"%SRCROOT%","index":5}},{"location":{"uri":"project/vite.config.ts","uriBaseId":"%SRCROOT%","index":6}},{"location":{"uri":"project/src/App.tsx","uriBaseId":"%SRCROOT%","index":7}}],"results":[],"newlineSequences":["\r\n","\n"," "," "],"columnKind":"utf16CodeUnits","properties":{"semmle.formatSpecifier":"sarif-latest"}}]}